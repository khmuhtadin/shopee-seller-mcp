# Example environment for the container / remote HTTP mode.
# Copy to .env (never commit the real file) or set these in your hosting dashboard.

# Public https base URL of this server, without a path.
SHOPEE_MCP_PUBLIC_URL=https://mcp.example.com

# Operator passphrase (12+ characters) for /admin/shops and OAuth consent.
# Applied on first boot only, unless SHOPEE_MCP_ADMIN_PASSPHRASE_RESET=true.
SHOPEE_MCP_ADMIN_PASSPHRASE=change-me-to-a-long-random-passphrase
SHOPEE_MCP_ADMIN_PASSPHRASE_RESET=false

# Shopee Open Platform app (live). Used when adding production shops.
SHOPEE_PARTNER_ID=123456
SHOPEE_PARTNER_KEY=replace-with-your-live-partner-key

# Optional sandbox app. When unset, sandbox uses the pair above.
# SHOPEE_SANDBOX_PARTNER_ID=123456
# SHOPEE_SANDBOX_PARTNER_KEY=replace-with-your-sandbox-partner-key

# Optional: per-client throttling behind a proxy you control (see docs/SECURITY.md).
# SHOPEE_MCP_CLIENT_IP_HEADER=X-Real-IP
# SHOPEE_MCP_TRUSTED_PROXIES=10.0.0.0/8

# Container settings.
PORT=8080
SHOPEE_MCP_DATA_DIR=/data
SHOPEE_MCP_LOG_LEVEL=info

# Client side: bearer token used by `shopee-mcp-http connect` snippets and scripts.
# SHOPEE_MCP_TOKEN=smcp_replace_with_token_from_token_create
